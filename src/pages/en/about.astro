---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config';

const alternates = [
  { lang: 'tr', href: '/hakkinda/' },
  { lang: 'en', href: '/en/about/' },
];
---

<BaseLayout
  title="About"
  description={`About ${SITE.author}.`}
  lang="en"
  alternates={alternates}
>
  <article>
    <header class="post-header">
      <h1>About</h1>
    </header>

    <div class="prose">
      <p>
        My personal blog: essays, things I learn and my thoughts.
      </p>

      <p>
        I use AI only for translation and small checks.
      </p>

      <p>
        If you want to reach me, mail me at 
        <a href="mailto:mirza.altay@protonmail.com">mirza.altay@protonmail.com</a>
        or follow along via <a href="/en/rss.xml">RSS</a>.
      </p>
    </div>

    <p class="back-link"><a href="/en/">← All posts</a></p>
  </article>
</BaseLayout>
