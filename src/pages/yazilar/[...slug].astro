---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTranslation, postSlug, postUrl } from '../../lib/posts';
import { ui, formatDate } from '../../i18n';

export async function getStaticPaths() {
  // Dev'de taslak yazılar da gezilebilir; build yalnızca yayındakileri üretir.
  const posts = await getPosts({ lang: 'tr' });
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const t = ui.tr;
const cover = post.data.cover;

const words = (post.body ?? '').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 200));

const translation = await getTranslation(post);
const alternates = [
  { lang: 'tr', href: postUrl(post) },
  ...(translation ? [{ lang: 'en', href: postUrl(translation) }] : []),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={cover?.src}
  type="article"
  noindex={post.data.draft}
  lang="tr"
  alternates={alternates}
>
  <article>
    <header class="post-header">
      <div class="post-meta">
        <time datetime={post.data.date.toISOString()}>
          {formatDate('tr', post.data.date)}
        </time>
        <span>{readingMinutes} {t.minRead}</span>
        {post.data.draft && <span class="draft-badge">{t.draft}</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p class="post-dek">{post.data.description}</p>

      {
        cover && (
          <figure class="post-cover">
            <Image
              src={cover}
              alt={post.data.coverAlt ?? ''}
              widths={[640, 960, 1440]}
              sizes="(max-width: 672px) calc(100vw - 2.5rem), 632px"
              priority
            />
          </figure>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      post.data.tags.length > 0 && (
        <ul class="post-tags">
          {post.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }

    <p class="back-link"><a href="/">{t.allPosts}</a></p>
  </article>
</BaseLayout>
