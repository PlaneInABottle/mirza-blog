---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { getPosts, postUrl } from '../lib/posts';
import { ui, formatDate } from '../i18n';

const posts = await getPosts({ lang: 'tr' });
const t = ui.tr;

const alternates = [
  { lang: 'tr', href: '/' },
  { lang: 'en', href: '/en/' },
  { lang: 'x-default', href: '/' },
];
---

<BaseLayout lang="tr" alternates={alternates}>
  <section class="intro">
    <Hero lang="tr" />
  </section>

  <section aria-labelledby="yazilar">
    <h2 class="section-title" id="yazilar">{t.posts}</h2>

    {
      posts.length === 0 ? (
        <p class="empty">{t.empty}</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a class="post-link" href={postUrl(post)}>
                <time datetime={post.data.date.toISOString()}>
                  {formatDate('tr', post.data.date)}
                </time>
                {post.data.draft && <span class="draft-badge">{t.draft}</span>}
                <span class="post-title">{post.data.title}</span>
                <span class="post-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
