---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const dateFormat = new Intl.DateTimeFormat('tr-TR', { dateStyle: 'long' });
---

<BaseLayout>
  <section class="intro">
    <h1>{SITE.title}</h1>
    <p class="lead">{SITE.description}</p>
  </section>

  <section aria-labelledby="yazilar">
    <h2 class="section-title" id="yazilar">Yazılar</h2>

    {
      posts.length === 0 ? (
        <p class="empty">Henüz yazı yok.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a class="post-link" href={`/yazilar/${post.id}/`}>
                <time datetime={post.data.date.toISOString()}>
                  {dateFormat.format(post.data.date)}
                </time>
                <span class="post-title">{post.data.title}</span>
                <span class="post-desc">{post.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
